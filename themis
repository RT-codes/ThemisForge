#!/usr/bin/env bash
# ThemisForge development CLI: ./themis start | stop | status | logs | build | build-images | doctor
# (An installed Themis has its own `themis` command, which installs, upgrades and runs it: see scripts/themisctl.py.)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN="$ROOT/.run"
mkdir -p "$RUN"

is_running() {
  [[ -f "$RUN/$1.pid" ]] && kill -0 "$(cat "$RUN/$1.pid")" 2>/dev/null
}

# Always leave frontend/dist fresh: port 8000 serves it, and a stale build is the classic "my change is not showing".
build_frontend() {
  local fe="$ROOT/frontend"
  if [[ ! -d "$fe/node_modules" || "$fe/package-lock.json" -nt "$fe/node_modules/.package-lock.json" ]]; then
    echo "Installing frontend dependencies..."
    (cd "$fe" && npm install --silent)
  fi
  echo "Building frontend..."
  if ! (cd "$fe" && npm run build --silent >"$RUN/build.log" 2>&1); then
    echo "Frontend build FAILED. Output:" >&2
    cat "$RUN/build.log" >&2
    exit 1
  fi
  echo "Frontend built ($(date +%H:%M:%S))"
}

start_one() { # name, dir, command...
  local name=$1 dir=$2
  shift 2
  if is_running "$name"; then
    echo "$name already running (pid $(cat "$RUN/$name.pid"))"
    return
  fi
  # the child writes its own pid then execs, so the pid is also its process group id
  (cd "$ROOT/$dir" && setsid bash -c 'echo $$ >"$0"; exec "$@"' "$RUN/$name.pid" "$@" >"$RUN/$name.log" 2>&1 &)
  sleep 0.2
  echo "$name started (pid $(cat "$RUN/$name.pid"))"
}

stop_one() {
  local name=$1
  if is_running "$name"; then
    local pid
    pid=$(cat "$RUN/$name.pid")
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true # the pid is the group leader, so this takes the whole tree
    echo "$name stopped"
  else
    echo "$name not running"
  fi
  rm -f "$RUN/$name.pid"
}

case "${1:-}" in
  build)
    build_frontend
    ;;
  build-images)
    # The cell image for Codex agents. Rebuild after changing docker/cell-codex/Dockerfile.
    docker build -t themisforge/cell-codex:latest "$ROOT/docker/cell-codex"
    ;;
  start)
    (cd "$ROOT/backend" && uv sync --quiet)
    build_frontend
    start_one backend backend uv run uvicorn app.main:app --reload --port 8000
    start_one frontend frontend npm run dev -- --port 5173 --strictPort
    echo
    echo "Open http://localhost:5173 (live reload) or http://localhost:8000 (the fresh build)"
    echo "Stop with: ./themis stop   Logs: ./themis logs"
    ;;
  stop)
    stop_one frontend
    stop_one backend
    ;;
  status)
    for n in backend frontend; do
      if is_running "$n"; then echo "$n running (pid $(cat "$RUN/$n.pid"))"; else echo "$n stopped"; fi
    done
    ;;
  logs)
    tail -n 30 -f "$RUN/backend.log" "$RUN/frontend.log"
    ;;
  doctor)
    shift
    cd "$ROOT/backend" && uv sync --quiet && exec uv run python -m app.doctor "$@"
    ;;
  *)
    echo "Usage: ./themis {start|stop|status|logs|build|build-images|doctor}"
    exit 1
    ;;
esac
